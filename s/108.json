{"n":108,"ayahs":[{"w":["إِنَّآ","أَعۡطَيۡنَٰكَ","ٱلۡكَوۡثَرَ"],"en":"Indeed, We have granted you, [O Muhammad], al-Kawthar","g":["Indeed, We","We have given you","Al-Kauthar"],"t":["innā","aʿṭaynāka","l-kawthara"],"ws":{"alafasy":[150,2130,4980],"sudais":[270,1980,3500],"shuraim":[30,850,1950],"husary":[330,1550,5660],"basit":[1500,4780,7820]}},{"w":["فَصَلِّ","لِرَبِّكَ","وَٱنۡحَرۡ"],"en":"So pray to your Lord and sacrifice [to Him alone]","g":["So pray","to your Lord","and sacrifice"],"t":["faṣalli","lirabbika","wa-in'ḥar"],"ws":{"alafasy":[30,920,1980],"sudais":[150,1120,2170],"shuraim":[70,520,1460],"husary":[30,1340,3190],"basit":[3260,4690,6760]}},{"w":["إِنَّ","شَانِئَكَ","هُوَ","ٱلۡأَبۡتَرُ"],"en":"Indeed, your enemy is the one cut off","g":["Indeed","your enemy ","he (is)","the one cut off"],"t":["inna","shāni-aka","huwa","l-abtaru"],"ws":{"alafasy":[30,1670,2760,3230],"sudais":[110,1110,2580,3170],"shuraim":[60,1170,2070,2410],"husary":[30,1400,3230,4070],"basit":[3590,3900,6320,7150]}}]}