{"n":64,"ayahs":[{"w":["يُسَبِّحُ","لِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۖ","لَهُ","ٱلۡمُلۡكُ","وَلَهُ","ٱلۡحَمۡدُۖ","وَهُوَ","عَلَىٰ","كُلِّ","شَيۡءࣲ","قَدِيرٌ"],"en":"Whatever is in the heavens and whatever is on the earth is exalting Allah. To Him belongs dominion, and to Him belongs [all] praise, and He is over all things competent","g":["Glorifies","[to] Allah","whatever","(is) in","the heavens","and whatever","(is) in","the earth","For Him","(is the) dominion","and for Him","(is) the praise","And He","(is) on","every","thing","All-Powerful"],"t":["yusabbiḥu","lillahi","mā","fī","l-samāwāti","wamā","fī","l-arḍi","lahu","l-mul'ku","walahu","l-ḥamdu","wahuwa","ʿalā","kulli","shayin","qadīrun"],"ws":{"alafasy":[30,1010,2040,2350,2570,4080,4650,4920,5750,6140,6990,7570,8450,9060,9640,10300,12030],"sudais":[320,1130,1900,2200,2370,3570,4040,4230,4870,5200,5970,6420,7140,7600,8100,8640,9550],"shuraim":[150,830,1560,1800,2000,3110,3540,3730,4350,4640,5270,5700,6350,6770,7190,7670,8480],"husary":[150,1690,3180,3800,4170,6540,7470,7870,10750,11320,12660,13650,16100,16920,17930,18950,21000],"basit":[3100,5020,6360,7120,7440,10490,11800,12820,null,null,21200,22580,24010,25310,26790,27820,30060]}},{"w":["هُوَ","ٱلَّذِي","خَلَقَكُمۡ","فَمِنكُمۡ","كَافِرࣱ","وَمِنكُم","مُّؤۡمِنࣱۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرٌ"],"en":"It is He who created you, and among you is the disbeliever, and among you is the believer. And Allah, of what you do, is Seeing","g":["He","(is) the One Who","created you","and among you","(is) a disbeliever","and among you","(is) a believer","And Allah","of what","you do","(is) All-Seer"],"t":["huwa","alladhī","khalaqakum","faminkum","kāfirun","waminkum","mu'minun","wal-lahu","bimā","taʿmalūna","baṣīrun"],"ws":{"alafasy":[30,330,1130,2160,4030,5640,8320,9530,10560,11140,12430],"sudais":[330,620,1290,2220,3350,4190,5280,6980,7870,8380,9470],"shuraim":[50,210,770,1560,2580,3590,4890,5650,6400,6860,7850],"husary":[300,750,203