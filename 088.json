ā","l-jibāli","kayfa","nuṣibat"],"ws":{"alafasy":[30,560,1630,2300],"sudais":[60,670,1770,2480],"shuraim":[110,540,1310,1790],"husary":[480,1370,3260,4420],"basit":[2630,3730,5350,6910]}},{"w":["وَإِلَى","ٱلۡأَرۡضِ","كَيۡفَ","سُطِحَتۡ"],"en":"And at the earth - how it is spread out","g":["And towards","the earth","how","it is spread out"],"t":["wa-ilā","l-arḍi","kayfa","suṭiḥat"],"ws":{"alafasy":[30,580,1470,2020],"sudais":[170,720,1640,2320],"shuraim":[70,470,1070,1510],"husary":[1100,2020,3530,4700],"basit":[3560,4770,5990,7320]}},{"w":["فَذَكِّرۡ","إِنَّمَآ","أَنتَ","مُذَكِّرࣱ"],"en":"So remind, [O Muhammad]; you are only a reminder","g":["So remind","only","you","(are) a reminder"],"t":["fadhakkir","innamā","anta","mudhakkirun"],"ws":{"alafasy":[30,920,3990,5210],"sudais":[100,870,2890,3130],"shuraim":[130,800,1600,2520],"husary":[550,2270,5540,7080],"basit":[4300,7780,8590,11060]}},{"w":["لَّسۡتَ","عَلَيۡهِم","بِمُصَيۡطِرٍ"],"en":"You are not over them a controller","g":["You are not","over them","a controller"],"t":["lasta","ʿalayhim","bimuṣayṭirin"],"ws":{"alafasy":[30,600,2220],"sudais":[190,790,2190],"shuraim":[60,470,1410],"husary":[600,1390,3940],"basit":[3300,4540,7780]}},{"w":["إِلَّا","مَن","تَوَلَّىٰ","وَكَفَرَ"],"en":"However, he who turns away and disbelieves","g":["But","whoever","turns away","and disbelieves"],"t":["illā","man","tawallā","wakafara"],"ws":{"alafasy":[30,810,1850,3010],"sudais":[70,860,1470,2490],"shuraim":[50,560,1010,1800],"husary":[700,1960,3010,5030],"basit":[1400,2630,4030,6400]}},{"w":["فَيُعَذِّبُهُ","ٱللَّهُ","ٱلۡعَذَابَ","ٱلۡأَكۡبَرَ"],"en":"Then Allah will punish him with the greatest punishment","g":["Then will punish him","Allah","(with) the punishment","greatest"],"t":["fayuʿadhibuhu","l-lahu","l-ʿadhāba","l-akbara"],"ws":{"alafasy":[30,1420,2290,3360],"sudais":[200,1570,2350,3260],"shuraim":[70,1160,1700,2490],"husary":[500,2990,4430,6320],"basit":[3200,6480,7990,10740]}},{"w":["إِنَّ","إِلَيۡنَآ","إِيَابَهُ